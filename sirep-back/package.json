{
  "name": "sirep-back",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "telegram:webhook": "node --env-file=.env scripts/telegram-webhook.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.22",
    "@supabase/supabase-js": "^2.45.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdfjs-dist": "4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.4"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
