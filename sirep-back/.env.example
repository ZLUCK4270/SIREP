PORT=3000

# --- Supabase (Local con Supabase CLI o Remoto) ---
SUPABASE_URL=http://127.0.0.1:54321
# Debe ser la service_role key (el backend escribe en Storage y en las tablas sin sesión de usuario)
SUPABASE_KEY=tu-service-role-key-aqui

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=tu_secreto_telegram_aqui
# Valida el header X-Telegram-Bot-Api-Secret-Token. Solo letras, números, "_" y "-" (máx. 256)
TELEGRAM_WEBHOOK_SECRET=tu_secreto_webhook_aqui
# URL pública https del backend, sin /telegram/webhook (la usa `npm run telegram:webhook`)
# En local: la URL que entrega ngrok o cloudflared
PUBLIC_URL=https://tu-dominio-o-tunel.example.com

# --- Proveedor de IA Activo (gemini | openai) ---
IA_PROVIDER=gemini

# Google Gemini (Predeterminado)
GEMINI_API_KEY=tu_secreto_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
# Intentos totales cuando Gemini responde 503/429 (sobrecarga) y espera inicial en ms, que se duplica en cada reintento.
# Con 5 intentos y 2000 ms el bot espera hasta 2+4+8+16 = 30 s antes de rendirse
GEMINI_REINTENTOS=5
GEMINI_ESPERA_MS=2000

# OpenAI (Para pruebas de viabilidad comparativas)
OPENAI_API_KEY=tu_secreto_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Procesamiento de escaneos ---
# Resolución a la que se convierte cada página del PDF en imagen
PDF_DPI=200
# Máximo de páginas por PDF (anverso y reverso = 2). Evita un costo de IA inesperado si envían un PDF largo
MAX_PAGINAS_REPORTE=4
# Lado largo (px) de la copia comprimida que se envía al modelo. 1600 es el valor de SIREGG;
# para manuscrito se ajusta con la prueba de viabilidad
IA_LADO_LARGO_PX=1600

# --- CORS (Frontend / Bandeja de revisión) ---
FRONTEND_URL=http://localhost:3001,http://localhost:5173
