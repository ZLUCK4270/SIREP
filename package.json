{
  "name": "sirep",
  "private": true,
  "workspaces": [
    "sirep-front/app",
    "sirep-front",
    "sirep-back"
  ],
  "scripts": {
    "dev": "cd sirep-front/app && bun run dev",
    "build": "cd sirep-front/app && bun run build",
